# ============================================================
# .gitignore — Transaltisa: Sistema de Procesamiento de Facturas
# ============================================================

# ─── Secrets / Credenciales ─────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
client_secret.json
token.json
google_credentials.json

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
*.egg

# ─── Node / Frontend ────────────────────────────────────────
node_modules/
dist/
.next/
.nuxt/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── IDEs ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Archivos temporales Office ─────────────────────────────
~$*

# ─── Archivos de respaldo (backups locales) ─────────────────
*.bak
*.bak[0-9]*
*.backup
*.orig

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/

# ─── PDFs de prueba con datos reales ────────────────────────
tests/samples/**/*.pdf

# ─── Docker ─────────────────────────────────────────────────
.dockerignore

# ─── Archivos grandes / binarios ────────────────────────────
*.docx
*.xlsx
*.zip
*.tar.gz
