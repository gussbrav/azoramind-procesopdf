# ============================================================
# .env.example — Copiar como .env y completar con valores reales
# ============================================================

# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/transaltisa

# JWT Auth
SECRET_KEY=cambia_esto_por_una_clave_secreta_aleatoria_minimo_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Modo demo (true = no requiere BD real, usa datos ficticios)
DEMO_MODE=false

# Claude API (Anthropic) — extracción de facturas
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# OCR API (Azoramind — Tesseract)
OCR_API_URL=https://azoramind-ocr-api.l7weu8.easypanel.host/process

# CORS (separar por comas)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Seguridad
LOGIN_RATE_LIMIT=5/minute
PASSWORD_MIN_LENGTH=12
ENABLE_HSTS=false
